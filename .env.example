# EarlyCore — copy to .env and fill in. No secrets are committed.
# Every integration degrades to a clearly-marked stub when its key is absent,
# so the demo runs offline; add keys to light up the real SDKs.

# ── Inference for the red team + the target agent ─────────────────────────────
# Promptfoo and the vulnerable agent use OpenAI by default.
OPENAI_API_KEY=

# Pioneer — point red-team / agent inference at Pioneer's endpoint instead.
# When set, the vulnerable agent and promptfoo provider use this base URL.
PIONEER_API_KEY=
PIONEER_BASE_URL=

# ── Sponsor integrations (real work; stubbed when unset) ──────────────────────
# Composio — fires the real autonomous Slack/Jira remediation actions.
COMPOSIO_API_KEY=

# ClickHouse — persists agent_events; powers the severity panel.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Langfuse — traces each autonomy-loop iteration.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Senso — pulls real regulatory clause text for control mapping, and publishes
# cited.md (citeable security evidence used to verify the submission).
SENSO_API_KEY=
# Builder handle from the Senso table — required for cited.md publishing.
SENSO_BUILDER_HANDLE=
# Override if your Senso workspace uses a different host.
SENSO_BASE_URL=

# Thesys C1 — generative-UI answers on the Ask page.
THESYS_API_KEY=

# ── UI / wiring ───────────────────────────────────────────────────────────────
PORT=4000
# Where the target agent runs (the red team + gateway attack this).
AGENT_URL=http://localhost:4100
# Standalone interception gateway port (npm run gateway).
PORT_GATEWAY=4200
# Composio Slack channel for autonomous alerts.
COMPOSIO_SLACK_CHANNEL=#security

# ── Demo behavior ─────────────────────────────────────────────────────────────
# EARLYCORE_STUB=1            force the deterministic stub findings (no agent needed)
# EARLYCORE_FAST=1            remove the on-camera step pacing
# EARLYCORE_MODE=promptfoo    run the full Promptfoo 22-scanner engine (needs a key)
